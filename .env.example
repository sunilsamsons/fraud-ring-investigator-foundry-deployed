# Copy this file to .env and put your real values in .env.
# .env is in .gitignore. This file holds only fake values.

# Neo4j (the database in docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j needs at least 8 characters.
NEO4J_PASSWORD=change-me-please

# Every LLM call (the chat and the data pipeline) uses gpt-5.4-mini in Microsoft Foundry.
# Sign in with: az login (no API key). On Foundry, the platform sets this value itself.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
